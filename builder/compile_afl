#!/bin/bash
#
# AFL build (Rust). OSS-Fuzz's compile_afl sets CC/CXX=afl-clang-fast and links the AFL++
# driver (libAFLDriver.a, holding aflpp_driver.o) via CUSTOM_LIBFUZZER_PATH. BUT for Rust the
# *linker* is the cargo linker, hardcoded to `clang` by base-builder-rust — so the AFL runtime
# (__afl_manual_init / __afl_area_ptr / __afl_persistent_loop / ...) that afl-clang-fast injects
# is never linked, and the final link fails with undefined `__afl_*` references. Fix: point the
# cargo linker at afl-clang-fast so the AFL runtime is linked in. (honggfuzz needs no such fix —
# its .a is self-contained.) Output key must match the `afl-build` phase in oss-crs/crs.yaml.
#
set -e

# Link Rust binaries with afl-clang-fast so the AFL runtime (__afl_* symbols) resolves.
export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER="${SRC}/aflplusplus/afl-clang-fast"

# Bound compile parallelism: -Ccodegen-units=1 + ASan is memory-heavy, and a wide cpuset
# spawns ~ncpu rustc jobs, which can exceed the builder memory limit. Cap it.
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}"

FUZZING_ENGINE=afl compile
libCRS submit-build-output "$OUT" afl
